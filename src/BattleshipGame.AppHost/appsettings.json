{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Resilience": {
    "OpenAiApi": {
      "MaxRetryAttempts": 3,
      "InitialRetryDelaySeconds": 2,
      "CircuitBreakerThreshold": 3,
      "CircuitBreakerBreakDurationSeconds": 60,
      "TimeoutSeconds": 30,
      "FailureRatio": 0.5
    }
  }
}
